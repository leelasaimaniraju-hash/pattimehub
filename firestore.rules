rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin') ||
        request.auth.token.email == 'admin@parttimehub.com' ||
        request.auth.token.email == 'leelasaimaniraju@gmail.com'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Employers collection - readable for company information on job postings
    match /employers/{employerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.employerId == request.auth.uid || isAdmin());
    }

    // Applications collection
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.jobSeekerId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.jobSeekerId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.jobSeekerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Saved Jobs collection
    match /savedJobs/{savedJobId} {
      allow read: if isAuthenticated() && (resource.data.jobSeekerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.jobSeekerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.jobSeekerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.jobSeekerId == request.auth.uid || isAdmin());
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
    }

    // Contact messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
